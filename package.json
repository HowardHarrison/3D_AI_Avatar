{
  "name": "ai-3d-avatar",
  "private": true,
  "version": "0.1.0",
  "description": "Phase 1 MVP: browser 3D avatar news presenter",
  "workspaces": [
    "apps/web",
    "packages/shared"
  ],
  "scripts": {

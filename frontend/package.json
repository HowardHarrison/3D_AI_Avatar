{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "generate:avatar": "python ../blender/scripts/generate_placeholder_glb.py",
    "generate:audio": "python ../blender/scripts/generate_test_audio.py",
    "avatar:inspect": "blender --background ../blender/source/presenter.blend --python ../blender/scripts/inspect_scene.py",
    "avatar:validate-rig": "blender --background ../blender/source/presenter.blend --python ../blender/scripts/validate_rig.py",
    "avatar:export": "blender --background ../blender/source/presenter.blend --python ../blender/scripts/export_glb.py",
    "avatar:validate-export": "python ../blender/scripts/validate_export.py",
    "avatar:promote": "python ../blender/scripts/promote_export.py",
    "avatar:release": "npm run avatar:export && npm run avatar:validate-export && npm run avatar:promote",
    "avatar:scaffold": "blender --background --python ../blender/scripts/scaffold_presenter_blend.py -- --force",
    "avatar:export-mixamo": "blender --background ../blender/source/presenter.blend --python ../blender/scripts/export_mesh_for_mixamo.py --",
    "avatar:import-rigged": "blender --background --python ../blender/scripts/import_base_glb.py -- --input ../blender/exports/mixamo_upload/giga_chad_rigged.fbx"
  },
  "dependencies": {
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}

VITE_APP_NAME=Stylized Chatbot Avatar
VITE_AVATAR_MODEL_URL=/avatars/ai_boy.glb
# true = FaceCard masks on Head (blank stylized stand-in); false = painted-face GLB
VITE_AVATAR_USE_FACE_PACK=false
VITE_ENABLE_DEBUG_PANEL=true
# Leave empty to use Vite proxy (/api → http://127.0.0.1:8000). Never put LLM keys here.
VITE_API_BASE_URL=

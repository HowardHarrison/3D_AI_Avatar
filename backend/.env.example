# Copy to .env for local overrides. Never commit real secrets.
APP_NAME=AI 3D Avatar API
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM — OpenAI initially; any OpenAI-compatible base URL later.
# Set the real key only in .env (gitignored). Leave blank until you use the provider.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Optional override (Azure, OpenRouter, local gateway). Empty = provider default.
LLM_BASE_URL=

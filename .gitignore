# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules/

# Build
dist/
dist-ssr/
*.local

# Environment (keep examples)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Blender
blender/source/*.blend1
blender/source/*.blend2
# Local recoverable backups from save_versioned_blend (keep folder via .gitkeep)
blender/source/versions/*
!blender/source/versions/.gitkeep
# Unvalidated temp exports (keep folder via .gitkeep)
blender/exports/tmp/*
!blender/exports/tmp/.gitkeep
# Local authoring blend (regenerate via scaffold_presenter_blend.py or import a licensed character)
blender/source/presenter.blend
# Local bone rename map (keep the .example.json in git)
blender/definitions/bone_rename_map.json

# Test / coverage
coverage/

# Docker
.docker/

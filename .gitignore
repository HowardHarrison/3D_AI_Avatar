# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Dependencies
node_modules/

# Build
dist/
dist-ssr/
*.local

# Environment (keep examples)
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Blender
blender/source/*.blend1
blender/source/*.blend2
# Local recoverable backups from save_versioned_blend (keep folder via .gitkeep)
blender/source/versions/*
!blender/source/versions/.gitkeep
# Unvalidated temp exports (keep folder via .gitkeep)
blender/exports/tmp/*
!blender/exports/tmp/.gitkeep
# Local authoring blend (regenerate via scaffold_presenter_blend.py or import a licensed character)
blender/source/presenter.blend
# Local bone rename map (keep the .example.json / .mixamo.json in git)
blender/definitions/bone_rename_map.json
# Local Mixamo upload/download binaries (keep README)
blender/exports/mixamo_upload/*
!blender/exports/mixamo_upload/README.md
blender/exports/giga_chad_rigged.glb
blender/exports/giga_chad_rigged.fbx

# graphify — rebuildable local cache (AST hashes, query stamps)
graphify-out/cache/
# Canonical graph lives only at repo root. Ignore accidental nested runs
# (e.g. `graphify update .` from backend/ or frontend/).
backend/graphify-out/
frontend/graphify-out/

# Python (backend/, blender/scripts/, etc.)
.venv/
venv/
**/__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
.uv/
backend/.tts_cache/
backend/tests/_tts_test_cache/

# Test / coverage
coverage/

# Docker
.docker/
